{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build engine",
      "type": "shell",
      "command": "makelove --config ../makelove.toml",
      "options": {
        "cwd": "${workspaceFolder}/engine"
      }
    },
    {
      "label": "Build documentation",
      "type": "shell",
      "command": "py build.py",
      "options": {
        "cwd": "${workspaceFolder}/docs"
      }
    }
  ]
}
